default_platform(:ios)

require 'dotenv' # ✅ Require the dotenv gem
require 'fileutils'
Dotenv.load(File.expand_path('.env.beta', __dir__))

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    UI.message 'Using configured Fastlane environment variables'

    asc_api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: ENV['ASC_KEY_FILE']
    )

    FileUtils.mkdir_p('ios')
    
    # 1. Pull down/update provisioning profiles & certificates from your signing repo
    match(
      type: "appstore",
      git_url: "git@github.com:rob-blasetti/signing-repo.git",
      app_identifier: "org.reactjs.native.example.liquid-spirit-mobile-app",
      api_key: asc_api_key
    )

    # 2. Increment build number
    increment_build_number(
      xcodeproj: "liquid_spirit_mobile_app.xcodeproj"
    )

    # 3. Inject Environment Variables into Xcode
    config_xcconfig = <<~CONFIG
      API_URL=#{ENV['API_URL']}
      AWS_ACCESS_KEY_ID=#{ENV['AWS_ACCESS_KEY_ID']}
      AWS_SECRET_ACCESS_KEY=#{ENV['AWS_SECRET_ACCESS_KEY']}
      AWS_REGION=#{ENV['AWS_REGION']}
    CONFIG
    File.write('ios/Config.xcconfig', config_xcconfig)

    # 4. Build the app
    build_app(
      workspace: "liquid_spirit_mobile_app.xcworkspace",
      scheme: "liquid_spirit_mobile_app",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "org.reactjs.native.example.liquid-spirit-mobile-app" => "match AppStore org.reactjs.native.example.liquid-spirit-mobile-app"
        }
      },
      # Force manual signing during the archive step too (prevents Xcode from trying automatic dev signing).
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=7MGG8ZRN25 PROVISIONING_PROFILE_SPECIFIER='match AppStore org.reactjs.native.example.liquid-spirit-mobile-app' CODE_SIGN_IDENTITY='Apple Distribution'"
    )

    # 5. Upload to TestFlight
    upload_to_testflight(
      api_key: asc_api_key
    )
  end
end
